meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "productId": 1,
    "quantity": 2
  }
}

assert {
  res.status: eq 201
}

docs {
  Creates an order. Text with a colon: and braces { like this }.
}
