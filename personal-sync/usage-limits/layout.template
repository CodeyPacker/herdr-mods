              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 14,
              "size": {
                "weight": 1
              }
            },
            {
              "id": "usage-limits",
              "type": "block",
              "size": {
                "weight": 2.2
              },
              "min": 130,
              "radius": 14,
              "border": {
                "width": 1,
                "color": "border"
              },
              "content": {
                "mod": "usage-limits"
              }
            }
          ]
        }
      ],
      "gap": 12,
      "resizable": false
    }
