      "min": 44,
      "max": 480,
      "gap": 12,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "islands-tabs"
          },
          "size": {
            "px": 38
