  "padding": 12,
  "theme": {
    "light": "paper",
    "dark": "slate-dark"
  },
  "terminal_padding": [
    16,
    14
  ],
  "terminal_opacity": 0,
  "gap": 12,
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/islands.svg"
}
