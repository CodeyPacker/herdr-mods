        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "islands-workspace-chrome"
          },
          "size": {
            "px": 38
          },
          "border": {
            "width": 1,
            "color": "border"
          },
          "radius": 14,
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
