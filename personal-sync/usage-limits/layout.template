            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "islands-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 14
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "islands-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 14
            }
          ],
          "gap": 12
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "islands-workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 72
          },
          "border": {
            "width": 1,
            "color": "border"
