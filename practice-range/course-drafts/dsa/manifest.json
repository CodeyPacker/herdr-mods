  "title": "Data structures and algorithms",
  "audience": [
    "Can write functions, loops and arrays in TypeScript",
    "Wants to choose data structures and algorithms deliberately"
  ],
  "prerequisiteConcepts": [
    "functions",
    "loops",
    "arrays",
    "objects"
  ],
  "entryPaths": [
    {
      "id": "beginner",
      "start": "course:dsa/module/cost",
      "order": "listed"
    },
    {
      "id": "experienced",
      "start": "course:dsa/module/cost",
      "readiness": [
        "R1",
        "R2",
        "R3"
      ],
      "description": "Try each group's readiness task or skip freely. A skip records navigation only."
    }
  ],
  "outcomes": [
    {
      "id": "outcome/cost",
      "description": "Count the steps a loop takes and name how they grow with the size of the input.",
      "assessment": "course:dsa/module/cost"
    },
    {
      "id": "outcome/arrays",
      "description": "Say what each array operation costs and solve a problem with two indexes in one pass.",
      "assessment": "course:dsa/module/arrays"
    },
    {
      "id": "outcome/search",
      "description": "Find a position in sorted data by halving the range, without off-by-one mistakes.",
      "assessment": "course:dsa/module/search"
    },
    {
      "id": "outcome/hashing",
      "description": "Use a Map or a Set to replace a search through a list with one lookup.",
      "assessment": "course:dsa/module/hashing"
    },
    {
      "id": "outcome/stacks",
      "description": "Choose last-in-first-out or first-in-first-out order and build each on an array.",
      "assessment": "course:dsa/module/stacks"
    },
    {
      "id": "outcome/linked",
      "description": "Walk, change and reverse a chain of nodes without losing part of it.",
      "assessment": "course:dsa/module/linked"
    },
    {
      "id": "outcome/recursion",
      "description": "Write a function that solves a problem by calling itself on a smaller one.",
      "assessment": "course:dsa/module/recursion"
    },
    {
      "id": "outcome/sorting",
      "description": "Sort with a simple method and with merge sort, and order records with a comparator.",
      "assessment": "course:dsa/module/sorting"
    },
    {
      "id": "outcome/trees",
      "description": "Walk a binary tree and search a binary search tree along one path.",
      "assessment": "course:dsa/module/trees"
    },
    {
      "id": "outcome/heaps",
      "description": "Keep the smallest item at hand with a heap stored in an array.",
      "assessment": "course:dsa/module/heaps"
    },
    {
      "id": "outcome/graphs",
      "description": "Store a graph and explore it level by level to find the fewest steps.",
      "assessment": "course:dsa/module/graphs"
    },
    {
      "id": "outcome/depth",
      "description": "Explore a graph depth first, detect a cycle, and order items by what they need.",
      "assessment": "course:dsa/module/depth"
    },
    {
      "id": "outcome/dynamic",
      "description": "Speed up a recursive solution by remembering answers to smaller problems.",
      "assessment": "course:dsa/module/dynamic"
    },
    {
      "id": "outcome/choose",
      "description": "Pick a data structure and an algorithm for a new problem, and justify the cost.",
      "assessment": "course:dsa/module/choose"
    }
  ],
