{
  "schemaVersion": "1-draft",
  "contentVersion": "0.1.0-draft.1",
  "id": "course:sql-foundations",
  "languageId": "sql",
  "runner": {
    "registeredLanguage": "sql",
    "compiler": {
      "name": "PGlite",
      "range": "=0.5.16"
    }
  },
  "title": "Answer questions with SQL",
  "audience": [
    "New to programming",
    "Already programs, new to SQL"
  ],
  "prerequisiteConcepts": [],
  "entryPaths": [
    {
      "id": "beginner",
      "start": "course:sql-foundations/module/save",
      "order": "listed"
    },
    {
      "id": "experienced",
      "start": "course:sql-foundations/module/save",
      "readiness": [
        "R1",
        "R2",
        "R3",
        "R4"
      ],
      "description": "Try each group's readiness task or skip freely. A skip records navigation only."
    }
  ],
  "outcomes": [
    {
      "id": "outcome/save",
      "description": "Run a query, read its result table, and find the line a SQL error names.",
      "assessment": "course:sql-foundations/module/save"
    },
    {
      "id": "outcome/select",
      "description": "Return chosen columns, computed columns with clear names, and distinct values.",
      "assessment": "course:sql-foundations/module/select"
    },
    {
      "id": "outcome/where",
      "description": "Filter rows with comparisons, AND, OR, IN, BETWEEN and LIKE, including the edge values.",
      "assessment": "course:sql-foundations/module/where"
    },
    {
      "id": "outcome/nulls",
      "description": "Find missing values, predict what NULL does to a comparison or a calculation, and supply a fallback.",
      "assessment": "course:sql-foundations/module/nulls"
    },
    {
      "id": "outcome/sorting",
      "description": "Sort by one or more columns, take the first rows, and place missing values on purpose.",
      "assessment": "course:sql-foundations/module/sorting"
    },
    {
      "id": "outcome/aggregates",
      "description": "Count, total and average rows, and choose the right kind of COUNT.",
      "assessment": "course:sql-foundations/module/aggregates"
    },
    {
      "id": "outcome/grouping",
      "description": "Produce one summary row per group and filter groups by their summary.",
      "assessment": "course:sql-foundations/module/grouping"
    },
    {
      "id": "outcome/joins",
      "description": "Join tables on their keys and read columns from both.",
      "assessment": "course:sql-foundations/module/joins"
    },
    {
      "id": "outcome/outer",
      "description": "Keep rows that have no match, and find the rows that have none.",
      "assessment": "course:sql-foundations/module/outer"
    },
    {
      "id": "outcome/subqueries",
      "description": "Compare rows with a computed value and test whether related rows exist.",
      "assessment": "course:sql-foundations/module/subqueries"
    },
    {
      "id": "outcome/ctes",
      "description": "Name the steps of a longer query with WITH and build on them.",
      "assessment": "course:sql-foundations/module/ctes"
    },
    {
      "id": "outcome/expressions",
      "description": "Label rows with CASE, convert types, and take parts of a date.",
      "assessment": "course:sql-foundations/module/expressions"
    },
    {
      "id": "outcome/modify",
      "description": "Insert, update and delete exactly the intended rows.",
      "assessment": "course:sql-foundations/module/modify"
    },
    {
      "id": "outcome/tables",
      "description": "Create a table whose keys and constraints reject bad data.",
      "assessment": "course:sql-foundations/module/tables"
    },
    {
      "id": "outcome/windows",
      "description": "Rank rows and compare each row with its group without collapsing the rows.",
      "assessment": "course:sql-foundations/module/windows"
    },
    {
      "id": "outcome/checks",
      "description": "Test a query's result against a known count and repair a join that counts rows twice.",
      "assessment": "course:sql-foundations/module/checks"
    },
    {
      "id": "outcome/assemble",
      "description": "Combine joins, grouping, steps and labels into one report.",
      "assessment": "course:sql-foundations/module/assemble"
    },
    {
      "id": "outcome/report",
      "description": "Independently answer a new reporting request and prove the answer with a check.",
      "assessment": "course:sql-foundations/module/report"
    }
  ],
  "modules": [
