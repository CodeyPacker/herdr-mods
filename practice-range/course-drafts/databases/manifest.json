{
  "schemaVersion": "1-draft",
  "contentVersion": "0.1.0-draft.1",
  "kind": "reading",
  "id": "course:databases",
  "title": "Databases",
  "audience": [
    "Can write SQL queries with joins and grouping",
    "Wants to know why a query is slow and how to keep data correct under load"
  ],
  "prerequisiteConcepts": [],
  "entryPaths": [
    {
      "id": "beginner",
      "start": "course:databases/module/storage",
      "order": "listed"
    }
  ],
  "outcomes": [
    {
      "id": "outcome/storage",
      "description": "Explain what a query costs in pages read, and why a growing table makes an unchanged query slow.",
      "assessment": "course:databases/module/storage"
    },
    {
      "id": "outcome/indexes",
      "description": "Say which queries a B-tree index can answer, when the database ignores one, and what each index costs.",
      "assessment": "course:databases/module/indexes"
    },
    {
      "id": "outcome/composite",
      "description": "Order the columns of a composite index for a query, and use an index to avoid a sort or a table visit.",
      "assessment": "course:databases/module/composite"
    },
    {
      "id": "outcome/plans",
      "description": "Read a query plan, find the step that takes the time, and compare estimated rows with actual rows.",
      "assessment": "course:databases/module/plans"
    },
    {
      "id": "outcome/joins",
      "description": "Recognise the three join methods in a plan, and find joins that are slow or that multiply rows.",
      "assessment": "course:databases/module/joins"
    },
    {
      "id": "outcome/modeling",
      "description": "Design tables that store each fact once, with keys, types and constraints that keep bad data out.",
      "assessment": "course:databases/module/modeling"
    },
    {
      "id": "outcome/denormalize",
      "description": "Decide when to store a derived value, and keep it correct and rebuildable.",
      "assessment": "course:databases/module/denormalize"
    },
    {
      "id": "outcome/transactions",
      "description": "Group changes into a transaction, keep it short, and say what it does not cover.",
      "assessment": "course:databases/module/transactions"
    },
    {
      "id": "outcome/isolation",
      "description": "Name the anomaly in a concurrency bug and choose a fix: an atomic update, a lock, a constraint or a version check.",
      "assessment": "course:databases/module/isolation"
    },
    {
      "id": "outcome/locking",
      "description": "Explain how lock waits and deadlocks arise, and find the transaction that blocks the others.",
      "assessment": "course:databases/module/locking"
    },
    {
      "id": "outcome/migrations",
      "description": "Change a schema on a large, busy table in steps that neither lock it for long nor break running code.",
      "assessment": "course:databases/module/migrations"
    },
    {
      "id": "outcome/connections",
      "description": "Size and use a connection pool, and remove wasted round trips from application code.",
      "assessment": "course:databases/module/connections"
    },
    {
      "id": "outcome/maintenance",
      "description": "Keep a database healthy: cleanup, statistics, query statistics, tested backups and a plan for old data.",
      "assessment": "course:databases/module/maintenance"
    },
    {
      "id": "outcome/tuning",
      "description": "Work through a slow query with one method, from measurement to a checked fix.",
      "assessment": "course:databases/module/tuning"
    },
    {
      "id": "outcome/review",
      "description": "Review a schema, its queries and a plan, and design a schema for a new product, without help.",
      "assessment": "course:databases/module/review"
    }
  ],
