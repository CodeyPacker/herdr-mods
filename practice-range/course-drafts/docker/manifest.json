{
  "schemaVersion": "1-draft",
  "contentVersion": "0.1.0-draft.1",
  "kind": "reading",
  "id": "course:docker",
  "title": "Run software in containers with Docker",
  "audience": [
    "Can use a terminal and has run a program from the command line",
    "Wants to package and run software with Docker"
  ],
  "prerequisiteConcepts": [],
  "entryPaths": [
    {
      "id": "beginner",
      "start": "course:docker/module/containers",
      "order": "listed"
    }
  ],
  "outcomes": [
    {
      "id": "outcome/containers",
      "description": "Explain what a container and an image are, and what a container isolates.",
      "assessment": "course:docker/module/containers"
    },
    {
      "id": "outcome/run",
      "description": "Start, inspect, stop and remove containers, and know what state each one is in.",
      "assessment": "course:docker/module/run"
    },
    {
      "id": "outcome/images",
      "description": "Read an image name, choose a tag deliberately, and say what a digest guarantees.",
      "assessment": "course:docker/module/images"
    },
    {
      "id": "outcome/dockerfile",
      "description": "Write a Dockerfile for a small service and control what goes into the build.",
      "assessment": "course:docker/module/dockerfile"
    },
    {
      "id": "outcome/layers",
      "description": "Order a Dockerfile so that rebuilds are fast and layers stay small.",
      "assessment": "course:docker/module/layers"
    },
    {
      "id": "outcome/start",
      "description": "Choose between CMD and ENTRYPOINT and make a container stop when it is asked to.",
      "assessment": "course:docker/module/start"
    },
    {
      "id": "outcome/config",
      "description": "Give one image different settings in different places, without putting secrets in it.",
      "assessment": "course:docker/module/config"
    },
    {
      "id": "outcome/storage",
      "description": "Say where a container's data lives and choose a volume, a bind mount or neither.",
      "assessment": "course:docker/module/storage"
    },
    {
      "id": "outcome/network",
      "description": "Publish a port, connect two containers by name, and explain what localhost means inside one.",
      "assessment": "course:docker/module/network"
    },
    {
      "id": "outcome/compose",
      "description": "Describe a multi-container app in one file and run it with one command.",
      "assessment": "course:docker/module/compose"
    },
    {
      "id": "outcome/health",
      "description": "Make services wait for what they need, restart after a failure, and stay within limits.",
      "assessment": "course:docker/module/health"
    },
    {
      "id": "outcome/small",
      "description": "Use a multi-stage build and a suitable base image to ship only what runs.",
      "assessment": "course:docker/module/small"
    },
    {
      "id": "outcome/secure",
      "description": "Reduce what a container can do and what an image is trusted to contain.",
      "assessment": "course:docker/module/secure"
    },
    {
      "id": "outcome/ship",
      "description": "Tag and push an image so that what was tested is exactly what runs.",
      "assessment": "course:docker/module/ship"
    },
    {
      "id": "outcome/debug",
      "description": "Work out why a container stopped, cannot be reached, or lost its data.",
      "assessment": "course:docker/module/debug"
    },
    {
      "id": "outcome/capstone",
      "description": "Review a flawed setup and plan how to containerize a small app, without help.",
      "assessment": "course:docker/module/capstone"
    }
  ],
