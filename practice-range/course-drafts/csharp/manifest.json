  "title": "Learn C#",
  "audience": [
    "New to programming",
    "Already programs, new to C#"
  ],
  "prerequisiteConcepts": [],
  "entryPaths": [
    {
      "id": "beginner",
      "start": "course:cs-foundations/module/save",
      "order": "listed"
    },
    {
      "id": "experienced",
      "start": "course:cs-foundations/module/save",
      "readiness": [
        "R1",
        "R2",
        "R3",
        "R4"
      ],
      "description": "Try each group's readiness task or skip freely. A skip records navigation only."
    }
  ],
  "outcomes": [
    {
      "id": "outcome/save",
      "description": "Save a short program, read its output, and find the line a compiler error names.",
      "assessment": "course:cs-foundations/module/save"
    },
    {
      "id": "outcome/values",
      "description": "Trace assignments, choose whole-number or fractional division, build text from values, and repair a type mismatch.",
      "assessment": "course:cs-foundations/module/values"
    },
    {
      "id": "outcome/decisions",
      "description": "Choose a branch with if, comparisons and boolean operators, including the edge values.",
      "assessment": "course:cs-foundations/module/decisions"
    },
    {
      "id": "outcome/methods",
      "description": "Write a static method with parameters and a return value, and explain why a name is out of scope.",
      "assessment": "course:cs-foundations/module/methods"
    },
    {
      "id": "outcome/collections",
      "description": "Build and walk an array and a List<T> with loops and a running total.",
      "assessment": "course:cs-foundations/module/collections"
    },
    {
      "id": "outcome/classes",
      "description": "Write a class with properties, a constructor and methods, and predict what two names for one object share.",
      "assessment": "course:cs-foundations/module/classes"
    },
    {
      "id": "outcome/records",
      "description": "Tell a copy from a shared reference, change a record with with, and predict == for records, structs and classes.",
      "assessment": "course:cs-foundations/module/records"
    },
    {
      "id": "outcome/nulls",
      "description": "Mark a value that may be missing with ?, check it before use, and supply a fallback with ?? while keeping zero and empty text.",
      "assessment": "course:cs-foundations/module/nulls"
    },
    {
      "id": "outcome/lookups",
      "description": "Count and group with a Dictionary, read a key that may be missing, and collect unique values with a HashSet.",
      "assessment": "course:cs-foundations/module/lookups"
    },
    {
      "id": "outcome/linq",
      "description": "Filter, transform, count and group with LINQ, and predict when a query actually runs.",
      "assessment": "course:cs-foundations/module/linq"
    },
    {
      "id": "outcome/interfaces",
      "description": "Implement an interface, extend a base type, and call different types through one contract.",
      "assessment": "course:cs-foundations/module/interfaces"
    },
    {
      "id": "outcome/patterns",
      "description": "Pick a result by record type and property values with a switch expression, with the arms in a correct order.",
      "assessment": "course:cs-foundations/module/patterns"
    },
    {
      "id": "outcome/exceptions",
      "description": "Throw and catch a specific exception, and choose between a result value and an exception for an expected failure.",
      "assessment": "course:cs-foundations/module/exceptions"
    },
    {
      "id": "outcome/generics",
      "description": "Write a generic method and type that keep the caller's type, with a constraint where one is needed.",
      "assessment": "course:cs-foundations/module/generics"
    },
    {
      "id": "outcome/async",
      "description": "Return and await a Task, run two reads in order, and handle a failed task.",
      "assessment": "course:cs-foundations/module/async"
    },
    {
      "id": "outcome/checks",
      "description": "Read expected and actual values, find an off-by-one bug, and write a check that catches it.",
      "assessment": "course:cs-foundations/module/checks"
    }
  ],
