{
  "schemaVersion": "1-draft",
  "contentVersion": "0.1.0-draft.1",
  "kind": "reading",
  "id": "course:api-design",
  "title": "Design APIs people can rely on",
  "audience": [
    "Can read JSON and has called or built an API",
    "Wants to design one well"
  ],
  "prerequisiteConcepts": [],
  "entryPaths": [
    {
      "id": "beginner",
      "start": "course:api-design/module/contract",
      "order": "listed"
    }
  ],
  "outcomes": [
    {
      "id": "outcome/contract",
      "description": "Explain what an API promises, who depends on it, and why its design is hard to change later.",
      "assessment": "course:api-design/module/contract"
    },
    {
      "id": "outcome/resources",
      "description": "Turn a problem into resources with clear, consistent names and addresses.",
      "assessment": "course:api-design/module/resources"
    },
    {
      "id": "outcome/methods",
      "description": "Choose a method by what it promises: safe, idempotent, or neither.",
      "assessment": "course:api-design/module/methods"
    },
    {
      "id": "outcome/status",
      "description": "Choose a status code that tells the client who has to act next.",
      "assessment": "course:api-design/module/status"
    },
    {
      "id": "outcome/shapes",
      "description": "Design request and response bodies that are consistent and hard to misread.",
      "assessment": "course:api-design/module/shapes"
    },
    {
      "id": "outcome/errors",
      "description": "Design an error response that a program can branch on and a person can fix.",
      "assessment": "course:api-design/module/errors"
    },
    {
      "id": "outcome/lists",
      "description": "Design filtering, sorting and pagination for a collection that keeps growing.",
      "assessment": "course:api-design/module/lists"
    },
    {
      "id": "outcome/writes",
      "description": "Make creates safe to retry and stop two clients from overwriting each other.",
      "assessment": "course:api-design/module/writes"
    },
    {
      "id": "outcome/versioning",
      "description": "Tell a breaking change from a safe one and plan how an API evolves.",
      "assessment": "course:api-design/module/versioning"
    },
    {
      "id": "outcome/auth",
      "description": "Separate who the caller is from what they may do, and answer each failure correctly.",
      "assessment": "course:api-design/module/auth"
    },
    {
      "id": "outcome/limits",
      "description": "Design limits and caching that protect the service and tell clients what to do.",
      "assessment": "course:api-design/module/limits"
    },
    {
      "id": "outcome/async",
      "description": "Design for work that takes longer than a request, and for telling clients that something happened.",
      "assessment": "course:api-design/module/async"
    },
    {
      "id": "outcome/styles",
      "description": "Compare resource, procedure, query and event styles and choose one for a situation.",
      "assessment": "course:api-design/module/styles"
    },
    {
      "id": "outcome/docs",
      "description": "Describe an API precisely and review a design against a checklist.",
      "assessment": "course:api-design/module/docs"
    },
    {
      "id": "outcome/capstone",
      "description": "Review a flawed API and design a small one from a brief, without help.",
      "assessment": "course:api-design/module/capstone"
    }
  ],
