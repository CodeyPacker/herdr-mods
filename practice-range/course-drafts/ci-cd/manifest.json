{
  "schemaVersion": "1-draft",
  "contentVersion": "0.1.0-draft.1",
  "kind": "reading",
  "id": "course:ci-cd",
  "title": "CI/CD",
  "audience": [
    "Uses version control and has opened a pull request",
    "Wants to understand, write and review build and deployment pipelines"
  ],
  "prerequisiteConcepts": [],
  "entryPaths": [
    {
      "id": "beginner",
      "start": "course:ci-cd/module/flow",
      "order": "listed"
    }
  ],
  "outcomes": [
    {
      "id": "outcome/flow",
      "description": "Explain what continuous integration and continuous delivery are, and trace a change from a commit to production.",
      "assessment": "course:ci-cd/module/flow"
    },
    {
      "id": "outcome/integrate",
      "description": "Keep a shared branch releasable with small changes and checks on every pull request.",
      "assessment": "course:ci-cd/module/integrate"
    },
    {
      "id": "outcome/workflow",
      "description": "Read a GitHub Actions workflow and say what runs, where, and in what order.",
      "assessment": "course:ci-cd/module/workflow"
    },
    {
      "id": "outcome/triggers",
      "description": "Choose the events that start a pipeline and stop runs from colliding.",
      "assessment": "course:ci-cd/module/triggers"
    },
    {
      "id": "outcome/stages",
      "description": "Arrange checks so that the cheapest failures are found first.",
      "assessment": "course:ci-cd/module/stages"
    },
    {
      "id": "outcome/speed",
      "description": "Shorten a pipeline with caching and parallel work, and deal with tests that fail at random.",
      "assessment": "course:ci-cd/module/speed"
    },
    {
      "id": "outcome/artifacts",
      "description": "Produce one identified artifact per change and reuse it in every later step.",
      "assessment": "course:ci-cd/module/artifacts"
    },
    {
      "id": "outcome/environments",
      "description": "Move one artifact through development, staging and production with the right gates.",
      "assessment": "course:ci-cd/module/environments"
    },
    {
      "id": "outcome/secrets",
      "description": "Give a pipeline the access it needs without storing long-lived keys, and limit what untrusted code can reach.",
      "assessment": "course:ci-cd/module/secrets"
    },
    {
      "id": "outcome/deploy",
      "description": "Choose between rolling, blue-green and canary deployment, and check a release before users see it.",
      "assessment": "course:ci-cd/module/deploy"
    },
    {
      "id": "outcome/rollback",
      "description": "Plan how to undo a release, and separate deploying code from turning a feature on.",
      "assessment": "course:ci-cd/module/rollback"
    },
    {
      "id": "outcome/database",
      "description": "Change a database's structure in steps that old and new code can both run against.",
      "assessment": "course:ci-cd/module/database"
    },
    {
      "id": "outcome/reuse",
      "description": "Share pipeline logic between repositories without copying it.",
      "assessment": "course:ci-cd/module/reuse"
    },
    {
      "id": "outcome/infrastructure",
      "description": "Describe an environment in a file, preview a change to it, and explain drift.",
      "assessment": "course:ci-cd/module/infrastructure"
    },
    {
      "id": "outcome/measure",
      "description": "Measure a delivery process with four numbers and notice a bad release quickly.",
      "assessment": "course:ci-cd/module/measure"
    },
    {
      "id": "outcome/capstone",
      "description": "Review a flawed pipeline and design one for a small service, without help.",
      "assessment": "course:ci-cd/module/capstone"
    }
  ],
