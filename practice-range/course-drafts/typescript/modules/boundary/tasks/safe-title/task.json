{
  "id": "course:ts-foundations/task/boundary-safe-title",
  "role": "guided",
  "title": "Read only a valid title",
  "concepts": [
    "unknown",
    "validation",
    "erasure"
  ],
  "prompt": "Return the title of a non-null, non-array object when title is a string, including empty text. For every other JSON value return null.",
  "hints": [
    "Trace the input with a numeric title.",
    "Check the surrounding object before reading its field.",
    "Check the field type without discarding empty text."
  ],
  "starter": "starter.ts",
  "solution": "solution.ts",
  "alternative": "alternative.ts",
  "mode": "script",
  "rules": [],
  "checks": [
    "__same(safeTitle({title:\"\"}), \"\")",
    "__same(safeTitle({title:4}), null)",
    "__same(safeTitle(null), null)",
    "__same(safeTitle([]), null)",
    "__same(safeTitle(\"hello\"), null)",
    "__same(safeTitle({}), null)",
    "__same(safeTitle({title:\"Mail\"}), \"Mail\")"
  ],
  "typeChecks": [],
  "rejects": [],
