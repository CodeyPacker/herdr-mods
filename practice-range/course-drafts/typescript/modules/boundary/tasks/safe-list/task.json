{
  "id": "course:ts-foundations/task/boundary-safe-list",
  "role": "review",
  "title": "Validate a list of labels",
  "concepts": [
    "unknown",
    "validation",
    "erasure"
  ],
  "prompt": "Return true for an array containing only strings. An empty array qualifies. A plain string or an array with any non-string fails.",
  "hints": [
    "Check the container before inspecting any item.",
    "Each item needs its own type check.",
    "An empty list has no invalid item."
  ],
  "starter": "starter.ts",
  "solution": "solution.ts",
  "alternative": "alternative.ts",
  "mode": "script",
  "rules": [],
  "checks": [
    "__same(labelsOnly([]), true)",
    "__same(labelsOnly([\"\", \"x\"]), true)",
    "__same(labelsOnly([\"x\", 0]), false)",
    "__same(labelsOnly(\"x\"), false)",
    "__same(labelsOnly(null), false)"
  ],
  "typeChecks": [],
  "rejects": [],
  "fixtures": [
    {
      "id": "cases",
      "declarations": "fixture-cases.ts"
    }
  ],
  "wrongAnswers": [
    {
      "source": "wrong-1.ts",
      "misconception": "Validates only the container.",
      "witness": {
        "fixture": "cases",
        "kind": "result",
        "detail": "Check 3 failed"
      }
    },
    {
      "source": "wrong-2.ts",
      "misconception": "Requires at least one item.",
      "witness": {
        "fixture": "cases",
        "kind": "result",
        "detail": "Check 1 failed"
      }
    }
  ],
  "feedback": "Check the container before inspecting any item."
}
