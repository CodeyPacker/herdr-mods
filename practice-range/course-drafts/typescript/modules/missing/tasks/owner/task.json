{
  "id": "course:ts-foundations/task/missing-owner",
  "role": "guided",
  "title": "Keep an empty nickname",
  "concepts": [
    "optional",
    "nullish",
    "literal-union",
    "narrowing"
  ],
  "prompt": "Write `nicknameOf(profile: Profile): string`. Return `profile.nickname` exactly when it is a string, even an empty one. Return `\"No nickname\"` when it is missing or `null`.",
  "hints": [
    "Try `{ nickname: \"\" }` first. Empty text is still a nickname.",
    "Which two values mean missing?",
    "`??` falls back only for `null` and `undefined`."
  ],
  "starter": "starter.ts",
  "solution": "solution.ts",
  "alternative": "alternative.ts",
  "mode": "script",
  "rules": [],
  "checks": [
    "__same(nicknameOf({nickname:\"\"}), \"\")",
    "__same(nicknameOf({}), \"No nickname\")",
    "__same(nicknameOf({nickname:null}), \"No nickname\")",
    "__same(nicknameOf({nickname:\"Sam\"}), \"Sam\")"
  ],
  "typeChecks": [],
  "rejects": [],
  "fixtures": [
    {
      "id": "cases",
      "declarations": "fixture-cases.ts"
    }
  ],
  "wrongAnswers": [
    {
      "source": "wrong-1.ts",
      "misconception": "Uses `||`, which also replaces empty text.",
      "witness": {
        "fixture": "cases",
        "kind": "result",
        "detail": "Check 1 failed"
      }
    },
    {
      "source": "wrong-2.ts",
      "misconception": "Checks only for `null`, so a missing field prints \"undefined\".",
      "witness": {
        "fixture": "cases",
        "kind": "result",
        "detail": "Check 2 failed"
      }
    }
  ],
  "feedback": "Try `{ nickname: \"\" }` first. Empty text is still a nickname."
}
