    "narrowing"
  ],
  "prompt": "Return the supplied owner's text exactly if present, including empty text. Return Unassigned for a missing or null owner.",
  "hints": [
    "Try an empty owner first.",
    "Which two values mean missing?",
    "Use a nullish fallback or two explicit checks."
  ],
  "starter": "starter.ts",
  "solution": "solution.ts",
  "alternative": "alternative.ts",
  "mode": "script",
  "rules": [],
  "checks": [
    "__same(ownerName({owner:\"\"}), \"\")",
    "__same(ownerName({}), \"Unassigned\")",
    "__same(ownerName({owner:null}), \"Unassigned\")",
    "__same(ownerName({owner:\"Mo\"}), \"Mo\")"
  ],
  "typeChecks": [],
  "rejects": [],
