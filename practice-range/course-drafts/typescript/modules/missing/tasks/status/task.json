{
  "id": "course:ts-foundations/task/missing-status",
  "role": "review",
  "title": "Describe a missing status",
  "concepts": [
    "optional",
    "nullish",
    "literal-union",
    "narrowing"
  ],
  "prompt": "A status is \"open\", \"done\" or null. Return \"Unknown\" for null, \"Active\" for open, and \"Closed\" for done.",
  "hints": [
    "List all three allowed inputs.",
    "Treat the missing case separately.",
    "Match each remaining literal with its requested text."
  ],
  "starter": "starter.ts",
  "solution": "solution.ts",
  "alternative": "alternative.ts",
  "mode": "script",
  "rules": [],
  "checks": [
    "__same(statusText(null), \"Unknown\")",
    "__same(statusText(\"done\"), \"Closed\")",
    "__same(statusText(\"open\"), \"Active\")"
  ],
  "typeChecks": [],
  "rejects": [],
  "fixtures": [
    {
      "id": "cases",
      "declarations": "fixture-cases.ts"
    }
  ],
  "wrongAnswers": [
    {
      "source": "wrong-1.ts",
      "misconception": "Merges open and done.",
      "witness": {
        "fixture": "cases",
        "kind": "result",
