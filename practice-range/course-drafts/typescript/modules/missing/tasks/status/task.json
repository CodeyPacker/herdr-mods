{
  "id": "course:ts-foundations/task/missing-status",
  "role": "review",
  "title": "Describe a missing delivery state",
  "concepts": [
    "optional",
    "nullish",
    "literal-union",
    "narrowing"
  ],
  "prompt": "A delivery state is `\"shipped\"`, `\"delivered\"` or `null`. Write `deliveryText`: return `\"Unknown\"` for `null`, `\"On the way\"` for `\"shipped\"` and `\"Arrived\"` for `\"delivered\"`.",
  "hints": [
    "There are three possible inputs. List them.",
    "Handle `null` on its own first.",
    "Match each remaining text value to its result."
  ],
  "starter": "starter.ts",
  "solution": "solution.ts",
  "alternative": "alternative.ts",
  "mode": "script",
  "rules": [],
  "checks": [
    "__same(deliveryText(null), \"Unknown\")",
    "__same(deliveryText(\"delivered\"), \"Arrived\")",
    "__same(deliveryText(\"shipped\"), \"On the way\")"
  ],
  "typeChecks": [],
  "rejects": [],
  "fixtures": [
    {
      "id": "cases",
      "declarations": "fixture-cases.ts"
    }
  ],
  "wrongAnswers": [
    {
      "source": "wrong-1.ts",
      "misconception": "Gives `\"delivered\"` the same text as `\"shipped\"`.",
      "witness": {
        "fixture": "cases",
        "kind": "result",
        "detail": "Check 2 failed"
      }
    },
    {
      "source": "wrong-2.ts",
