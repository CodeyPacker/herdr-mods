  "prompt": "Use a Map of titles by numeric ID. Return the existing title, including empty text, or null when the key is absent. A missing key is an ordinary outcome.",
  "hints": [
    "An existing value may be empty.",
    "Read the value for the requested key.",
    "Handle the Map’s missing-key result explicitly."
  ],
  "starter": "starter.ts",
  "solution": "solution.ts",
  "alternative": "alternative.ts",
  "mode": "script",
  "rules": [],
  "checks": [
    "__same(lookup(new Map([[2,\"\"]]), 2), \"\")",
    "__same(lookup(new Map(), 7), null)",
    "__same(lookup(new Map([[1,\"Post\"]]), 1), \"Post\")"
  ],
