{
  "id": "course:ts-foundations/task/generic-edit-shapes",
  "role": "independent",
  "title": "Describe a task preview and patch",
  "concepts": [
    "generic",
    "utility"
  ],
  "prompt": "The supplied Task has id, title and done. Define Preview containing only id and title, and Patch accepting optional title and done fields. A patch cannot set id. Use the supplied field types. No runtime transformation is requested.",
  "hints": [
    "Describe the visible preview fields first.",
    "A patch can leave both editable fields absent.",
    "Remove id before making the editable fields optional."
  ],
  "starter": "starter.ts",
  "solution": "solution.ts",
  "alternative": "alternative.ts",
  "mode": "script",
  "rules": [],
  "checks": [],
  "typeChecks": [
    "__Extends<{id:number;title:string},Preview>",
    "__Extends<Preview,{id:number;title:string}>",
    "__Extends<{},Patch>",
    "__Extends<{title:string;done:boolean},Patch>"
  ],
  "rejects": [
    "const p: Patch = {id: 4}",
    "const p: Patch = {done: \"yes\"}",
    "const p: Preview = {id: 2}",
    "const p: Preview = {id: 2,title:\"\",done:false}"
  ],
  "fixtures": [
    {
      "id": "cases",
      "declarations": "fixture-cases.ts"
    }
  ],
  "wrongAnswers": [
    {
      "source": "wrong-1.ts",
      "misconception": "Requires done on a preview.",
      "witness": {
        "fixture": "cases",
        "kind": "types",
        "detail": "Type check 1"
      }
    },
    {
      "source": "wrong-2.ts",
      "misconception": "Allows id in a patch.",
      "witness": {
        "fixture": "cases",
        "kind": "types",
        "detail": "id"
      }
    }
  ],
  "feedback": "Describe the visible preview fields first."
}
