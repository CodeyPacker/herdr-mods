  ],
  "prompt": "Declare a type `Seat` for an object with `row: number` and `booked: boolean`, both required. An object missing either field, or with a field of the wrong type, must not be assignable to `Seat`.",
  "hints": [
    "List both fields with their types.",
    "A `?` after a field name makes it optional. Neither field here is optional.",
    "`type Seat = { ... }` and `interface Seat { ... }` both work."
  ],
  "starter": "starter.ts",
  "solution": "solution.ts",
  "alternative": "alternative.ts",
  "mode": "script",
  "rules": [],
  "checks": [],
  "typeChecks": [
    "__Extends<{row:number;booked:boolean}, Seat>",
    "__Extends<Seat, {row:number;booked:boolean}>"
  ],
  "rejects": [
    "const x: Seat = { booked: true }",
    "const x: Seat = { row: 2 }",
    "const x: Seat = { row: 2, booked: \"yes\" }"
