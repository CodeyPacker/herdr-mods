        "R4"
      ],
      "description": "Try each group’s readiness task or skip freely. A skip records navigation only."
    }
  ],
  "outcomes": [
    {
      "id": "outcome/save",
      "description": "Save a two-line script and identify the output and the line of an error.",
      "assessment": "course:ts-foundations/module/save"
    },
    {
      "id": "outcome/values",
      "description": "Trace assignments, compute a number, construct a label, and repair a type mismatch.",
      "assessment": "course:ts-foundations/module/values"
    },
    {
      "id": "outcome/decisions",
      "description": "Choose a branch using equality, ordering and boolean operators. Distinguish empty text and zero from absent data.",
      "assessment": "course:ts-foundations/module/decisions"
    },
    {
      "id": "outcome/functions",
      "description": "Write a typed function with a return value and local state. Explain why a name is out of scope.",
      "assessment": "course:ts-foundations/module/functions"
    },
    {
      "id": "outcome/lists",
      "description": "Build and traverse an array with a for-of loop and an accumulator.",
      "assessment": "course:ts-foundations/module/lists"
    },
    {
      "id": "outcome/shapes",
      "description": "Describe a task with a type alias or interface, read a property and update an object while keeping its input intact.",
      "assessment": "course:ts-foundations/module/shapes"
    },
    {
      "id": "outcome/missing",
      "description": "Represent a missing owner or due date. Use string literal unions, null checks and typeof to narrow a value.",
      "assessment": "course:ts-foundations/module/missing"
    },
    {
      "id": "outcome/unions",
      "description": "Write union and literal types, predict widening, and narrow a union before using it.",
      "assessment": "course:ts-foundations/module/unions"
    },
    {
      "id": "outcome/collections",
      "description": "Select and transform tasks with callbacks. Build a Map of groups and a Set of unique owners.",
      "assessment": "course:ts-foundations/module/collections"
    },
    {
      "id": "outcome/tagged",
      "description": "Model tag/payload pairs, use the tag to compute a result, and repair a field read.",
      "assessment": "course:ts-foundations/module/tagged"
    },
    {
      "id": "outcome/boundary",
      "description": "Accept unknown input, distinguish it from unchecked any, and inspect real properties before accepting a task.",
      "assessment": "course:ts-foundations/module/boundary"
    },
    {
      "id": "outcome/modules",
      "description": "Import and export values and types. Locate strict and target in supplied compiler settings and predict their roles.",
      "assessment": "course:ts-foundations/module/modules"
    },
    {
      "id": "outcome/checks",
      "description": "Interpret expected and actual values, isolate an off-by-one defect, and write a distinguishing test.",
      "assessment": "course:ts-foundations/module/checks"
    },
    {
      "id": "outcome/errors",
      "description": "Separate an expected business outcome from an exception and safely explain an unknown thrown value.",
      "assessment": "course:ts-foundations/module/errors"
    },
    {
      "id": "outcome/async",
      "description": "Return a promise, await a local source and handle fulfillment and rejection.",
      "assessment": "course:ts-foundations/module/async"
    },
    {
      "id": "outcome/generic",
      "description": "Preserve input/output types with a generic function and describe task projections with Pick, Omit and Partial.",
      "assessment": "course:ts-foundations/module/generic"
    }
  ],
