[
  {
    "label": "Lost local snapshot",
    "source": "reject",
    "expected": {
      "kind": "unavailable"
    }
  },
  {
    "label": "Null batch",
    "source": "resolve",
    "value": null,
    "expected": {
      "kind": "invalid-batch"
    }
  },
  {
    "label": "Object instead of list",
    "source": "resolve",
    "value": {
      "id": "A",
      "done": false
    },
    "expected": {
      "kind": "invalid-batch"
    }
  },
  {
    "label": "Empty list",
    "source": "resolve",
    "value": [],
    "expected": {
      "kind": "report",
      "open": 0,
      "done": 0,
      "rejected": 0,
      "duplicates": 0
    }
  },
  {
    "label": "First valid task wins",
    "source": "resolve",
    "value": [
      {
        "id": "A",
        "done": false
      },
      {
        "id": "A",
        "done": true
      },
      {
        "id": "B",
        "done": true
      },
      {
        "id": "A",
        "done": false
      }
    ],
    "expected": {
      "kind": "report",
      "open": 1,
      "done": 1,
      "rejected": 0,
      "duplicates": 2
    }
  },
  {
    "label": "Invalid records never reserve an ID",
    "source": "resolve",
    "value": [
      {
        "id": "A",
        "done": "yes"
      },
      {
        "id": "A",
        "done": true
      },
      {
        "id": "A",
        "done": 1
      },
      null,
      [],
      false,
      {
        "id": "",
        "done": false
      }
    ],
    "expected": {
      "kind": "report",
      "open": 0,
      "done": 1,
      "rejected": 6,
      "duplicates": 0
    }
  },
  {
    "label": "Case-sensitive IDs are used exactly",
    "source": "resolve",
    "value": [
      {
        "id": "a",
        "done": false
      },
      {
        "id": "A",
        "done": true
      },
      {
        "id": " ",
        "done": false
      },
      {
        "id": "a",
        "done": true,
        "notes": "extra"
      }
    ],
    "expected": {
      "kind": "report",
      "open": 2,
      "done": 1,
      "rejected": 0,
      "duplicates": 1
    }
  },
  {
    "label": "Missing fields and extra keys",
    "source": "resolve",
    "value": [
      {},
      {
        "id": "x"
      },
      {
        "done": true
      },
      {
        "id": 1,
        "done": true
      },
      {
        "id": "x",
        "done": false,
        "notes": "ok"
      }
    ],
    "expected": {
      "kind": "report",
      "open": 1,
      "done": 0,
      "rejected": 4,
      "duplicates": 0
    }
  }
]
